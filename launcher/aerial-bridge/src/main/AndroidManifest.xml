<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Aerial 启动兼容"
        android:icon="@drawable/bridge_icon"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoDisplay">
        <activity
            android:name="com.gathin.tvhome.MainActivity"
            android:exported="true"
            android:directBootAware="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name="com.gathin.tvhome.StartupReceiver"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="mitv.action.STR_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
